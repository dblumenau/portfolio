---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'David Blumenau | Useful things, made personal', description = 'Software by David Blumenau. Explore PanelForge, connected agent systems and smaller tools built around real problems.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://danishdave.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1e9" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead wrap">
      <a class="wordmark" href="/" aria-label="David Blumenau home"><span class="brand-mark" aria-hidden="true">d<span>.</span>b</span><span>David<br />Blumenau</span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Selected work</a>
        <a href="/#approach">About</a>
        <a class="nav-contact" href="/#contact">Get in touch <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer wrap" id="contact">
      <div class="footer-top"><p class="eyebrow">A useful conversation starts somewhere</p><a class="contact-link" href="mailto:dblumenau@gmail.com">Let's make something useful. <span aria-hidden="true">↗</span></a><div class="contact-options"><a href="mailto:dblumenau@gmail.com">Email me</a><a href="https://github.com/dblumenau">GitHub ↗</a><a href="https://www.linkedin.com/in/dblumenau/">LinkedIn ↗</a></div></div>
      <div class="footer-bottom"><a class="footer-name" href="/">David Blumenau</a><p>Personal projects. Made, used, and kept in working order.</p><a href="#top">Back to top ↑</a></div>
    </footer>
  </body>
</html>
