---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { labs } from '../../data/labs';
const recommendedLabs = ['studio', 'listening', 'attention'].map(id => labs.find(lab => lab.id === id)!);
---
<BaseLayout title="Small experiments | David Blumenau" description="Make a graphic, keep a creative direction, try a graph correction or inspect actual tool and engine experiments.">
  <main id="main" class="wrap lab-index">
    <header id="top"><a class="lab-index-back" href="/"><Icon name="arrow-left" /> Back to the portfolio</a><p class="eyebrow">Small experiments / useful consequences</p><h1>See what happens<br /><em>when you try it.</em></h1><p class="lab-index-intro">Try a creative tool, explore a memory, or follow a real experiment through to its recorded result. Each starts with a small problem.</p><nav class="lab-quick-launch" aria-label="Start with an experiment">{recommendedLabs.map(lab => <a href={`/labs/${lab.id}/`}>{lab.quickLabel} <Icon name="arrow-up-right" /></a>)}</nav></header>
    <div class="lab-collection">{labs.map(lab => <article class={`lab-card lab-card-${lab.id}`}><div class="lab-card-top"><span>{lab.number}</span><p class="eyebrow">{lab.label}</p></div><div class="lab-card-illustration" aria-hidden="true">
      {lab.id === 'studio' && <img src="/media/studio/sample-print-preview-960.webp" srcset="/media/studio/sample-print-preview-480.webp 480w, /media/studio/sample-print-preview-960.webp 960w" sizes="auto, (max-width: 700px) calc(100vw - 36px), 640px" width="1080" height="1080" alt="" loading="lazy" decoding="async" />}
      {lab.id === 'listening' && <svg viewBox="0 0 320 180"><rect x="24" y="26" width="272" height="128" rx="5" fill="#fbf8ec" stroke="#879c7d"/><rect x="101" y="42" width="87" height="29" rx="3" fill="#d9ee8b"/><text x="160" y="62" text-anchor="middle" fill="#344d3d" font-size="16" font-family="sans-serif">En lille historie.</text><path d="M40 110h12m4-5v10m6-18v26m6-19v12m6-25v38m6-28v18m6-35v52m6-33v14m6-26v38m6-23v8m6-22v36m6-24v12m6-20v28m6-19v10m6-8v6m6-14v22m6-28v34m6-23v12m6-30v48m6-36v24m6-18v12m6-25v38m6-27v16m6-33v50m6-36v22m6-16v10m6-6v4m6-17v30m6-23v16m6-12v8m6-14v20m6-16v12m6-8v4m6-6v8m5-4h12" stroke="#344d3d" stroke-width="2"/><path d="M105 82v57m82-57v57" stroke="#a2452d" stroke-width="2"/></svg>}
      {lab.id === 'curation' && <svg viewBox="0 0 320 180"><path d="M65 55h76m38 0h76M65 125h76m38 0h76M65 75v30" fill="none" stroke="#879c7d" stroke-width="2"/><g fill="#fbf8ec" stroke="#879c7d"><rect x="23" y="30" width="84" height="50" rx="4"/><rect x="213" y="30" width="84" height="50" rx="4"/><rect x="23" y="100" width="84" height="50" rx="4"/></g><rect x="213" y="100" width="84" height="50" rx="4" fill="#d9ee8b" stroke="#344d3d"/><path d="M37 48h55m-55 12h37m135-12h55m-55 12h35M37 118h55m-55 12h37m135-12h55m-55 12h35" stroke="#344d3d" stroke-width="2"/><path d="M148 55h26m-6-6 6 6-6 6m-20 64h26m-6-6 6 6-6 6" fill="none" stroke="#344d3d" stroke-width="2"/></svg>}
      {lab.id === 'archive' && <svg viewBox="0 0 320 180"><rect x="24" y="35" width="123" height="113" rx="4" fill="#344d3d"/><path d="M25 58h121M68 76h36" stroke="#d9ee8b" stroke-width="3"/><g fill="#fbf8ec"><rect x="40" y="95" width="24" height="34"/><rect x="74" y="95" width="24" height="34"/><rect x="108" y="95" width="24" height="34"/></g><path d="M158 92h29m-8-7 8 7-8 7" fill="none" stroke="#879c7d" stroke-width="2"/><rect x="199" y="49" width="96" height="87" rx="4" fill="#fbf8ec" stroke="#879c7d"/><path d="M211 70h71m-71 17h71m-71 17h71M232 61v56" stroke="#879c7d"/><circle cx="284" cy="133" r="20" fill="#d9ee8b" stroke="#344d3d"/><path d="m274 133 7 7 14-16" fill="none" stroke="#344d3d" stroke-width="2"/></svg>}
      {lab.id === 'attention' && <svg viewBox="0 0 320 180"><rect x="18" y="36" width="132" height="102" rx="5" fill="#344d3d"/><path d="m34 55 9 7-9 7m18 0h18M33 91h94m-94 13h62" fill="none" stroke="#d9ee8b" stroke-width="2"/><path d="M151 71h28m-7-6 7 6-7 6M179 116h-28m7-6-7 6 7 6" fill="none" stroke="#879c7d" stroke-width="2"/><rect x="185" y="25" width="116" height="129" rx="8" fill="#fbf8ec" stroke="#879c7d"/><path d="M200 44h85m-85 11h64" stroke="#344d3d" stroke-width="2"/><rect x="199" y="75" width="87" height="23" rx="4" fill="#ecefe2"/><rect x="199" y="107" width="87" height="27" rx="4" fill="#d9ee8b"/><path d="m210 120 5 5 10-12m10 7h37" fill="none" stroke="#344d3d" stroke-width="2"/></svg>}
      {lab.id === 'question' && <svg viewBox="0 0 320 180"><rect x="30" y="23" width="100" height="134" rx="12" fill="#344d3d"/><path d="M64 31h32M66 148h28" stroke="#d9ee8b" stroke-width="3" stroke-linecap="round"/><rect x="43" y="54" width="75" height="31" rx="7" fill="#d9ee8b"/><path d="M53 65h52m-52 9h38" stroke="#344d3d" stroke-width="2"/><g fill="none" stroke="#a3b996" stroke-width="2"><path d="M130 89h36m-7-6 8 6-8 6M129 123h37" stroke-dasharray="3 3"/></g><rect x="178" y="40" width="112" height="100" rx="5" fill="#fbf8ec" stroke="#879c7d"/><circle cx="199" cy="61" r="8" fill="#d9ee8b" stroke="#344d3d"/><path d="m194 61 4 4 7-8M218 61h55M192 87h82m-82 12h69m-69 12h77m-77 12h46" stroke="#344d3d" fill="none" stroke-width="2"/></svg>}
      {lab.id === 'margin' && <svg viewBox="0 0 320 180"><rect x="24" y="18" width="272" height="144" rx="4" fill="#fbf8ec" stroke="#879c7d"/><path d="M52 19v142M25 53h270M25 83h270M25 113h270M25 143h270" fill="none" stroke="#cad3bd"/><g fill="none" stroke="#344d3d" stroke-width="2" stroke-linecap="round"><path d="M65 44q7-12 12-2t13 0m9 2q8-12 12-2t12 0m10 2q9-12 12-2t12 0M65 74q6-12 12-2t14 0m9 2q6-12 12-2t12 0M65 104q6-12 12-2t12 0m10 2q8-12 12-2t15 0"/></g><path d="M170 76h19" stroke="#a2452d" stroke-dasharray="3 3"/><rect x="190" y="64" width="88" height="73" rx="3" fill="#eee0d4" stroke="#ad6a54" stroke-dasharray="3 3"/><path d="M208 80v16m8-16v16M206 111h53m-53 9h35" stroke="#a2452d" stroke-width="2"/></svg>}
      {lab.id === 'branches' && <svg viewBox="0 0 320 180"><g fill="none" stroke="#879c7d" stroke-width="2"><path d="M160 47v38M58 115V85h204v30M160 85v30"/></g><rect x="128" y="15" width="64" height="40" rx="4" fill="#344d3d"/><path d="M142 31h35m-35 8h24" fill="none" stroke="#d9ee8b" stroke-width="2"/><g fill="#ecefe2" stroke="#879c7d"><rect x="22" y="115" width="72" height="45" rx="4"/><rect x="124" y="115" width="72" height="45" rx="4"/></g><rect x="226" y="115" width="72" height="45" rx="4" fill="#d9ee8b" stroke="#344d3d"/><g fill="none" stroke="#344d3d" stroke-width="2"><path d="M36 130h44m-44 9h27M138 130h44m-44 9h35m63-2 8 8 14-18"/></g></svg>}
      {lab.id === 'gateway' && <svg viewBox="0 0 320 180"><g fill="none" stroke="#879c7d" stroke-width="2"><path d="M48 90H140m40 0 66-40m-66 40 66 40"/></g><circle cx="48" cy="90" r="21" fill="#d9ee8b" stroke="#879c7d"/><rect x="132" y="62" width="56" height="56" rx="9" fill="#344d3d"/><path d="m160 73 14 5v10c0 11-14 19-14 19s-14-8-14-19V78Z" fill="none" stroke="#d9ee8b" stroke-width="2"/><circle cx="260" cy="45" r="20" fill="#e1e8d8" stroke="#879c7d"/><path d="m250 45 7 7 13-14" fill="none" stroke="#344d3d" stroke-width="2"/><circle cx="260" cy="135" r="20" fill="#eee0d4" stroke="#ad6a54"/><path d="m253 128 14 14m0-14-14 14" fill="none" stroke="#a2452d" stroke-width="2"/></svg>}
      {lab.id === 'memory' && <svg viewBox="0 0 320 180"><g fill="none" stroke="#879c7d" stroke-width="1.5"><path d="M160 88L55 48M160 88L255 43M160 88L270 137M160 88L70 148"/><path d="M55 48Q36 140 70 148" stroke-dasharray="4 5"/></g><g fill="#ecefe2" stroke="#879c7d"><circle cx="55" cy="48" r="19"/><circle cx="255" cy="43" r="16"/><circle cx="270" cy="137" r="22"/><circle cx="70" cy="148" r="13"/></g><circle cx="160" cy="88" r="35" fill="#344d3d"/><text x="160" y="94" text-anchor="middle" fill="#d9ee8b" font-size="16" font-family="sans-serif">why?</text><path d="M148 145a21 21 0 1 0 35-17m-2 15 2-15 15 2" fill="none" stroke="#a2452d" stroke-width="2"/></svg>}
      {lab.id === 'workbench' && <svg viewBox="0 0 320 180"><rect x="20" y="36" width="121" height="88" rx="4" fill="#344d3d"/><rect x="179" y="36" width="121" height="88" rx="4" fill="#344d3d"/><g fill="none" stroke="#a3b996" stroke-width="2"><path d="M30 55H131M189 55H290M80 125v14m160-14v14M51 141h59m101 0h59M142 80h36"/></g><g fill="#d9ee8b" font-size="14" font-family="monospace"><text x="37" y="83">shared</text><text x="197" y="83">shared</text></g><g fill="#e9dfbd" font-size="11" font-family="monospace"><text x="37" y="104">local: A</text><text x="197" y="104">local: B</text></g><circle cx="160" cy="80" r="8" fill="#a2452d"/></svg>}
      {lab.id === 'recovery' && <svg viewBox="0 0 320 180"><g fill="none" stroke-width="2"><path d="M31 62h73m32 0h151" stroke="#879c7d" stroke-dasharray="5 6"/><path d="M31 125h256" stroke="#344d3d"/><path d="m106 52 23 20m0-20-23 20" stroke="#a2452d"/></g><g fill="#344d3d"><circle cx="31" cy="62" r="7"/><circle cx="31" cy="125" r="7"/><circle cx="151" cy="125" r="7"/><circle cx="287" cy="125" r="7"/></g><rect x="239" y="40" width="65" height="43" rx="3" fill="#d9ee8b" stroke="#879c7d"/><path d="m255 61 10 9 20-21" fill="none" stroke="#344d3d" stroke-width="3"/><g fill="#596159" font-family="sans-serif" font-size="10"><text x="24" y="36">CLIENT</text><text x="24" y="153">ENGINE</text></g></svg>}
    </div><h2>{lab.title}</h2><p class="lab-card-description">{lab.description}</p><ol aria-label="Experiment steps">{lab.steps.map(step => <li>{step}</li>)}</ol><a href={`/labs/${lab.id}/`}>{lab.action}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><p class="lab-card-evidence">{lab.detail}</p></article>)}</div>
    <aside class="lab-index-further"><div><p class="eyebrow">Follow the idea further</p><h2>There is a story behind each experiment.</h2></div><div><a class="text-link" href="/features/">Browse the feature atlas <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><a class="text-link" href="/world/">Find your way through Forge World <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></aside>
  </main>
</BaseLayout>
<style>
  .lab-index{padding-block:30px 85px}
  .lab-index-back{display:inline-block;font-size:.8rem;text-decoration:none;padding-block:10px;margin-bottom:35px}
  header>.eyebrow{color:var(--rust);margin-bottom:22px}
  h1{font-size:clamp(3.25rem,6vw,6.5rem);line-height:1.04}
  h1 em{color:var(--forest)}
  .lab-index-intro{max-width:700px;color:var(--muted);font-size:1.05rem;line-height:1.8;margin-top:27px}
  .lab-quick-launch{display:flex;flex-wrap:wrap;gap:9px;margin-top:25px}
  .lab-quick-launch a{display:inline-flex;gap:18px;align-items:center;justify-content:space-between;min-height:46px;padding:11px 15px;border:1px solid #aebba3;background:#e9eddf;text-decoration:none;font-size:.78rem;font-weight:600}
  .lab-quick-launch a:first-child{background:var(--forest);border-color:var(--forest);color:var(--paper)}
  .lab-quick-launch a:hover{background:var(--acid);color:var(--ink)}
  @media(max-width:600px){.lab-index-back{margin-bottom:24px}header>.eyebrow{margin-bottom:18px}.lab-quick-launch{display:grid;grid-template-columns:1fr 1fr;gap:8px}.lab-quick-launch a{font-size:.7rem;padding:10px;gap:9px}}
  .lab-collection{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:50px 48px;margin-top:55px}
  .lab-card{min-width:0;display:flex;flex-direction:column;align-items:stretch;border-top:1px solid var(--ink);padding-top:20px}
  .lab-card-top{display:flex;gap:15px;align-items:center}
  .lab-card-top>span{color:var(--rust);font-family:var(--serif);font-style:italic;font-size:1.5rem}
  .lab-card-top .eyebrow{font-size:.58rem;color:var(--muted)}
  .lab-card-illustration{height:190px;overflow:hidden;display:flex;align-items:center;justify-content:center;margin:17px 0 23px;background:#e6eadb;border:1px solid var(--line);border-radius:3px}
  .lab-card-recovery .lab-card-illustration{background:#ede6d8}
  .lab-card-workbench .lab-card-illustration{background:#e6e4d5}
  .lab-card-illustration svg{display:block;width:100%;height:100%}
  .lab-card-illustration img{width:100%;height:100%;object-fit:cover;object-position:center 35%}
  .lab-card:last-child:nth-child(odd){grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:0 48px}
  .lab-card:last-child:nth-child(odd) .lab-card-top{grid-column:1/-1}
  .lab-card:last-child:nth-child(odd) .lab-card-illustration{grid-column:1;grid-row:2/7;align-self:center;height:260px;margin-top:0}
  .lab-card:last-child:nth-child(odd) h2,.lab-card:last-child:nth-child(odd)>.lab-card-description,.lab-card:last-child:nth-child(odd)>ol,.lab-card:last-child:nth-child(odd)>a,.lab-card:last-child:nth-child(odd)>.lab-card-evidence{grid-column:2}
  .lab-card:last-child:nth-child(odd) h2{margin-top:17px}
  .lab-card h2{font-size:clamp(1.8rem,2.4vw,2.6rem);max-width:390px;line-height:1.12}
  .lab-card-description{font-size:.9rem;color:var(--muted);line-height:1.75;margin:18px 0 22px}
  .lab-card ol{display:flex;gap:8px;flex-wrap:wrap;list-style:none;margin:auto 0 22px;padding:0}
  .lab-card li{font-size:.62rem;background:#e6eadb;border:1px solid var(--line);padding:5px 8px;border-radius:2px}
  .lab-card>a{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 0;border-top:1px solid var(--ink);text-decoration:none;font-size:.88rem;font-weight:600}
  .lab-card>a:hover{color:var(--rust)}
  .lab-card>a>span{font-size:1.3rem}
  .lab-card-evidence{font-size:.68rem;color:var(--muted);line-height:1.7;max-width:340px}
  .lab-index-further{display:grid;grid-template-columns:1.2fr 1fr;gap:60px;border-top:1px solid var(--line);padding-top:35px;margin-top:75px;align-items:end}
  .lab-index-further .eyebrow{color:var(--rust);margin-bottom:15px}
  .lab-index-further h2{font-size:2rem;max-width:500px}
  .lab-index-further>div:last-child{display:flex;flex-direction:column;align-items:start}
  .lab-index-further .text-link{font-size:.8rem}
  @media(max-width:900px){.lab-collection{gap:20px}.lab-card h2{font-size:1.8rem}}
  @media(max-width:700px){.lab-card:last-child:nth-child(odd){grid-column:auto;display:flex}.lab-card:last-child:nth-child(odd) .lab-card-illustration{height:190px;align-self:stretch;margin-top:17px}.lab-card:last-child:nth-child(odd) h2{margin-top:0}.lab-collection{grid-template-columns:1fr;gap:45px;margin-top:40px}.lab-card-illustration{max-width:400px;width:100%}.lab-card h2{font-size:2.35rem}.lab-card ol{margin-top:0}.lab-index-further{grid-template-columns:1fr;gap:25px}.lab-index-intro{font-size:.95rem}.lab-card-top .eyebrow{font-size:.64rem}}
</style>
