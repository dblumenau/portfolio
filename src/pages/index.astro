---
import Icon from '../components/Icon.astro';
import OverviewFilm from '../components/OverviewFilm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ScreenShowcase from '../components/ScreenShowcase.astro';
import VideoDemo from '../components/VideoDemo.astro';
import Architecture from '../components/Architecture.astro';
import ExploreWorkbench from '../components/ExploreWorkbench.astro';
import KitforgeOutput from '../components/KitforgeOutput.astro';
import ReleaseCards from '../components/ReleaseCards.astro';
import { caseStudies, releaseStories, supportingProjects, supportingVignettes, siteCopy } from '../data/projects';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { Image } from 'astro:assets';
import portrait from '../assets/david-portrait.jpg';
import { imageDimensions } from '../data/media';
const panelforge = caseStudies.find((project) => project.slug === 'panelforge')!;
const hasHero = existsSync(resolve('public/media/panelforge-gallery-desktop.webp'));
const hasAsset = (path: string) => existsSync(resolve('public', path.slice(1)));
---
<BaseLayout>
  <main id="main">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow"><span class="small-cross" aria-hidden="true"><Icon name="asterisk" /></span> Developer / Copenhagen</p><h1 id="hero-title">I make the tools<br />I wish <em>existed.</em></h1><p class="hero-intro">{siteCopy.intro}</p><OverviewFilm><a class="button button-dark" href="#work">Take a look around <span aria-hidden="true"><Icon name="arrow-down" /></span></a></OverviewFilm><nav class="hero-experiments" aria-label="Try something I built"><a href="/labs/studio/"><span><strong>Make a print</strong><small>Edit it here. Download the result.</small></span><Icon name="arrow-up-right" /></a><a href="/labs/recovery/"><span><strong>Recover an answer</strong><small>See a disconnected task finish.</small></span><Icon name="arrow-up-right" /></a></nav></div>
      <div class="hero-visual"><div class="hero-note"><span class="note-dot" aria-hidden="true"></span>From a small idea<br />to a working thing.</div><a class="hero-preview" href="/work/panelforge/" aria-label="Explore PanelForge"><div class="preview-header"><span>01 / PanelForge</span><span aria-hidden="true"><Icon name="arrow-up-right" /></span></div>{hasHero ? <img src="/media/panelforge-gallery-desktop.webp" width="1440" height="960" alt="A preview of the PanelForge image gallery." fetchpriority="high" /> : <div class="missing-media"><p>PanelForge</p><span>Product capture being prepared</span></div>}<div class="preview-footer"><span>Images, references, conversations.</span><span>View case study <Icon name="arrow-up-right" /></span></div></a><span class="hero-registration" aria-hidden="true">+ useful things, made personal +</span></div>
      <div class="hero-baseline"><p>Selected projects, from the visible interface to the less visible plumbing.</p><span>Scroll to explore <Icon name="arrow-down" /></span></div>
    </section>

    <section class="featured-work" id="work" aria-labelledby="featured-title">
      <div class="wrap"><div class="featured-intro"><div><p class="eyebrow"><span class="section-number">01</span> The workspace that kept growing</p><h2 id="featured-title">PanelForge.<br /><em>A place for the whole idea.</em></h2></div><div class="featured-description"><p>The gallery gives images a place to live. References can move into a conversation, and preserved branches keep earlier directions available.</p><a class="text-link light-link" href="/work/panelforge/">The story behind PanelForge <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><a class="text-link light-link" href="/work/panelforge/#image-revision">Compare a generated image revision <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><a class="text-link light-link" href="/labs/branches/">Replay a reference and two revisions <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></div>
        <ScreenShowcase id="home-panelforge" desktop={panelforge.image} desktopAlt={panelforge.imageAlt} mobile="/media/panelforge-gallery-mobile.webp" mobileAlt="PanelForge gallery at a phone viewport, with selected images and responsive navigation." label="PanelForge" caption="The same gallery at desktop and phone sizes, captured in the working product." />
        <div class="featured-facts"><div><span>01 / Create</span><p>Generate, inspect and revise a result.</p></div><div><span>02 / Keep</span><p>Give assets a place in the workspace.</p></div><div><span>03 / Continue</span><p>Carry context into the next conversation.</p></div></div>
      </div>
    </section>

    <ExploreWorkbench />

    <section class="systems-section wrap" aria-labelledby="systems-title">
      <SectionHeading id="systems-title" number="02" label="Behind the screen" title="The parts that make it hold together." intro={siteCopy.architectureIntro} />
      <div class="system-case-links">{caseStudies.filter(project => !['panelforge','conference-notes'].includes(project.slug)).map((project) => <a class="system-case-link" href={`/work/${project.slug}/`}><span class="case-link-number">{project.number}</span><div><p class="eyebrow">{project.category}</p><h3>{project.name}</h3><p>{project.intro}</p></div><span class="case-link-arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span></a>)}</div>
      <Architecture />
    </section>

    <aside class="wrap" aria-label="Conference Notes case study">
      <a class="conference-home-link" href="/work/conference-notes/"><img src="/media/conference-notes-deck-theme.webp" {...imageDimensions('/media/conference-notes-deck-theme.webp')} alt="An editable theme slide generated from the fictional conference notes." loading="lazy" /><div><p class="eyebrow">Conference Notes / From the room to the follow-up</p><h3>Keep the ideas after the room empties.</h3><p>A mobile notebook, inspectable themes and an editable presentation. Walk through the real application with fictional conference data.</p><span class="text-link">Explore the conference workflow <span aria-hidden="true"><Icon name="arrow-up-right" /></span></span></div></a>
    </aside>

    <section class="small-work-section wrap" aria-labelledby="small-work-title">
      <SectionHeading id="small-work-title" number="03" label="Smaller tools, real jobs" title="Sometimes the right size is small." intro="A few focused projects with a straightforward purpose. Different interfaces, the same interest in making something useful." />
      <div class="supporting-projects">{supportingProjects.map((project, index) => <article class={`supporting-project supporting-${index}`}><div class="supporting-visual"><span class="product-type">{project.status}</span>{hasAsset(project.image) ? <a href={project.image} aria-label={`View screenshot of ${project.name}`}><img src={project.image} alt={project.alt} {...imageDimensions(project.image)} loading="lazy" decoding="async" /></a> : <div class="missing-media"><p>{project.name}</p><span>Authentic product capture being prepared</span></div>}</div>{project.mediaCaption && <p class="media-caption">{project.mediaCaption}</p>}<div class="supporting-copy"><p class="eyebrow">{project.name} / {project.label}</p><h3>{project.title}</h3><p>{project.description}</p><a class="text-link" href={project.href}>{project.link} <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div>{project.video && <VideoDemo src={project.video} poster={project.image} title={`A walk through ${project.name}`} description={project.videoDescription ?? project.description} captions={project.captions} mediaCaption={project.mediaCaption} />}{index === 0 && <><a class="text-link" href="/labs/studio/">Make your own in the Studio Lab <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><KitforgeOutput /></>}</article>)}</div>
      <div class="vignette-strip"><p class="eyebrow">Also on the workbench</p><div>{supportingVignettes.map((project) => <article><h3>{project.name}</h3><p>{project.description}</p><span>{project.tag}</span>{project.href && <a class="text-link vignette-link" href={project.href}>{project.link} <Icon name="arrow-up-right" /></a>}</article>)}</div></div>
    </section>

    <section class="iteration-section" aria-labelledby="iteration-title"><div class="wrap"><SectionHeading id="iteration-title" number="04" label="The work after it works" title="The little changes are part of the story." intro={siteCopy.releasesIntro} /><ReleaseCards stories={releaseStories} /><a class="text-link" href="/releases/">Explore the complete release map <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><p class="history-note">Historical milestones from repository release tags. Tags mark source checkpoints. Their dates can differ from deployment and public launch dates.</p></div></section>

    <section class="approach-section wrap" id="approach" aria-labelledby="approach-title"><div class="approach-heading"><p class="eyebrow"><span class="section-number">05</span> A little about how I work</p><h2 id="approach-title">Follow the<br /><em>problem through.</em></h2><figure class="author-photo"><Image src={portrait} width={420} format="webp" alt="David Blumenau smiling outdoors in a snowy landscape." loading="lazy" /><figcaption>David Blumenau · developer in Copenhagen</figcaption></figure></div><div class="approach-copy"><p>{siteCopy.approach}</p><p>I also write about what happens when these tools become part of everyday life. Sometimes the story is technical. Sometimes it involves an unreasonable number of agents.</p><a class="text-link" href="https://blog.danishdave.com">Read my writing <span aria-hidden="true"><Icon name="arrow-up-right" /></span></a></div></section>
  </main>
</BaseLayout>
