---
import Icon from './Icon.astro';
import { imageDimensions } from '../data/media';
import milestones from '../releases/milestones.json';
import summary from '../releases/summary.json';
import { areas, periods, position, formatDate } from '../releases/model';
const label = (id: string) => summary.projects.find(project => project.id === id)?.label ?? id;
const selected = milestones.find(story => story.id === 'session-peek')!;
const media: Record<string, { src: string; alt: string; caption: string }> = {
  'history-digest': { src: '/media/code-history-week.webp', alt: 'PanelForge Code History week with daily activity bars and selected digest cards.', caption: 'A current product capture of the weekly digest. Private session details are redacted.' },
  'session-peek': { src: '/media/code-history-peek.webp', alt: 'A session preview showing the archived work that built Code History.', caption: 'The actual Code History implementation session, opened in the current product. Its open questions describe that historical record.' },
};
const slots = new Map<string, number>();
const marks = milestones.map((story, index) => { const key = `${story.area}-${story.date.slice(0,7)}`; const slot = slots.get(key) ?? 0; slots.set(key,slot+1);return { ...story,number:index+1,slot }; });
---
<section class="release-explorer" data-release-explorer id="top">
  <div class="release-intro"><div><p class="eyebrow">A history of useful changes</p><h1>One problem<br />led to the next<span>.</span></h1></div><div class="release-intro-copy"><p>The image needed a home. The conversation needed a memory. The agent needed a way to finish when the browser disappeared.</p><p>Follow the decisions that connected a creative workspace, three agent runtimes and a portable workbench.</p><a class="release-jump" href="#release-reading">Read the chronological story <Icon name="arrow-down" /></a></div></div>
  <form class="release-filter-form" aria-label="Filter release history">
    <fieldset disabled data-release-controls>
      <legend>Choose a part of the journey</legend>
      <div class="release-filter-main"><label>Period<select name="period">{periods.map(period => <option value={period.id}>{period.label}</option>)}<option value="custom">Custom dates</option></select></label><label>Project<select name="project"><option value="">All projects</option>{summary.projects.map(project => <option value={project.id}>{project.label}</option>)}</select></label><label>Version marker<select name="kind"><option value="">All markers</option><option value="major">Major · X.0.0</option><option value="minor">Minor · X.Y.0</option><option value="patch">Patch · X.Y.Z</option><option value="commit">Pre-tag / source commit</option><option value="other">Other tag</option></select></label><label>Search<input name="query" type="search" placeholder="A feature, project or version" /></label></div>
      <div class="release-filter-dates"><label>From<input type="date" name="from" value="2025-05-01" min="2025-01-01" max="2026-10-31" /></label><span aria-hidden="true"><Icon name="arrow-right" /></span><label>Through<input type="date" name="to" value="2026-10-31" min="2025-01-01" max="2026-10-31" /></label><button type="reset">Reset filters</button><p>Dates include both endpoints.</p></div>
      <div class="release-share"><button type="button" data-release-copy>Copy view link <Icon name="link" /></button><p>Keep the filters and selected milestone.</p><p role="status" aria-live="polite" data-release-copy-status></p></div>
      <label class="release-share-fallback" data-release-link-fallback hidden>View link<input type="text" readonly aria-label="View link" /></label>
    </fieldset>
  </form>
  <noscript><p class="release-note">The complete curated story and repository coverage below can be read without JavaScript. Enable JavaScript to focus the map and browse the full tag inventory.</p></noscript>
  <div class="release-map-heading"><div><p class="eyebrow">The growth map</p><h2 data-period-caption>From the first revision loop to a connected workbench.</h2></div><p class="release-result" role="status" aria-live="polite" data-release-status>30 reviewed milestones across the ecosystem</p></div>
  <p class="release-map-help">Each numbered marker opens a decision and its consequence. Position shows time; lanes connect related work across repositories.</p>
  <div class="release-map" aria-label="Chronological map of reviewed milestones">
    <div class="release-map-axis" aria-hidden="true"><span>May 2025</span><span>Oct 2025</span><span>Mar 2026</span><span>Oct 2026</span></div>
    {areas.map(area => <div class={`release-lane lane-${area.id}`} data-lane={area.id}><div class="release-lane-name"><h3>{area.label}</h3><p>{area.note}</p></div><div class="release-lane-track">{marks.filter(story=>story.area===area.id).map(story => <a class:list={['release-marker',`marker-${story.kind}`, { 'is-selected': story.id===selected.id }]} href={`#milestone-${story.id}`} title={`${formatDate(story.date)} · ${story.title}`} data-milestone={story.id} data-date={story.date} data-area={story.area} data-slot={story.slot} aria-current={story.id===selected.id ? 'true' : undefined} aria-label={`${String(story.number).padStart(2,'0')}. ${formatDate(story.date)}. ${story.title}. ${label(story.project)}. ${story.tag ?? 'Source commit'}`} style={`--position:${position(story.date,'2025-05-01','2026-10-31')}%;--slot:${story.slot%3};--shift:${Math.floor(story.slot/3)*35}px;`}><span class="release-marker-number">{String(story.number).padStart(2,'0')}</span><span class="release-marker-mobile"><time datetime={story.date}>{formatDate(story.date)}</time><span>{story.title}</span></span></a>)}</div></div>)}
  </div>
  <div class="release-map-key"><span><i class="key-major"></i> Major marker</span><span><i class="key-minor"></i> Minor marker</span><span><i class="key-patch"></i> Patch marker</span><span><i class="key-commit"></i> Source commit</span></div>
  <div class="release-focus-wrap" data-focus-wrap><div class="release-focus-top"><p class="eyebrow">The decision in focus</p><div><button type="button" data-story-prev aria-label="Previous matching milestone"><Icon name="arrow-left" /> Previous</button><button type="button" data-story-next aria-label="Next matching milestone">Next <Icon name="arrow-right" /></button></div></div><div class="release-focus" tabindex="-1" data-release-focus>
    <div><p class="release-story-meta"><time datetime={selected.date}>{formatDate(selected.date)}</time> · {label(selected.project)} · {selected.kind} marker</p><h3>{selected.title}</h3><p class="release-problem">{selected.problem}</p><p>{selected.change}</p><div class="release-consequence"><span>What it made possible</span><p>{selected.next}</p></div><p class="release-proof"><code>{selected.tag ?? selected.commit}</code> · {selected.evidence}</p><a class="release-story-link" href={selected.href}>Explore the related work <Icon name="arrow-up-right" /></a></div><figure><img src={media['session-peek'].src} alt={media['session-peek'].alt} {...imageDimensions(media['session-peek'].src)} loading="lazy" /><figcaption>{media['session-peek'].caption}</figcaption></figure>
  </div><button class="release-map-return" type="button" data-map-return>Back to the growth map <Icon name="arrow-up" /></button></div>
  <p class="release-note">These are historical source milestones. A tag is often a deployment checkpoint; the version’s shape does not measure the importance of a feature. Repository work began before the first deployment tags.</p>
  <details class="release-reading" id="release-reading"><summary><span>Read the milestones as a timeline</span><span>30 reviewed changes <Icon name="arrow-down" /></span></summary><ol class="release-story-list">{milestones.map((story,index)=><li id={`milestone-${story.id}`} data-story={story.id}><span class="release-story-number">{String(index+1).padStart(2,'0')}</span><article class="release-story-content"><p class="release-story-meta"><time datetime={story.date}>{formatDate(story.date)}</time> · {label(story.project)} · {story.kind} marker</p><h3>{story.title}</h3><p class="release-problem">{story.problem}</p><p>{story.change}</p><div class="release-consequence"><span>What it made possible</span><p>{story.next}</p></div><p class="release-proof"><code>{story.tag ?? story.commit}</code> · {story.evidence}</p><a class="release-story-link" href={story.href}>Explore the related work <Icon name="arrow-up-right" /></a>{media[story.id]&&<figure><img src={media[story.id].src} alt={media[story.id].alt} {...imageDimensions(media[story.id].src)} loading="lazy" /><figcaption>{media[story.id].caption}</figcaption></figure>}</article></li>)}</ol><p hidden data-empty-stories>No curated milestone matches these filters. The tag inventory may still contain matching checkpoints.</p></details>
  <details class="release-inventory" data-release-inventory><summary><div><p class="eyebrow">Go deeper</p><h2>The full checkpoint inventory</h2><p>{summary.tagCount.toLocaleString('en-GB')} verified tags · {summary.projects.length} inspected repositories · snapshot {formatDate(summary.asOf)}</p></div><span aria-hidden="true"><Icon name="plus" /></span></summary><div class="release-inventory-inner"><p>The same filters apply here. This index contains tag names, dates, projects and short commit identifiers. Reviewed stories above explain selected changes; a tag alone does not.</p><p class="release-inventory-status" data-inventory-status role="status" aria-live="polite">Open this section with JavaScript enabled to browse the inventory.</p><div class="release-table-scroll" tabindex="0" role="region" aria-label="Filtered tag inventory"><table><caption class="sr-only">Release tag checkpoints, ordered by date</caption><thead><tr><th scope="col">Date</th><th scope="col">Project</th><th scope="col">Tag</th><th scope="col">Marker</th><th scope="col">Commit</th></tr></thead><tbody data-tag-rows></tbody></table></div><div class="release-pagination"><button type="button" data-tags-prev disabled><Icon name="arrow-left" /> Earlier page</button><p data-tag-page></p><button type="button" data-tags-next disabled>Later page <Icon name="arrow-right" /></button><button type="button" data-tags-download disabled>Download filtered JSON</button></div></div></details>
  <details class="release-coverage"><summary>How the history was checked <span aria-hidden="true"><Icon name="plus" /></span></summary><div><p>Curated milestones combine verified Git references with reviewed implementation and archive rationale. Commit milestones establish source changes; they are not launch announcements or present availability claims.</p><p>{summary.dateBasis} {summary.firstCommitBasis}</p><p>{summary.cacheNote} Tags are ordered by date, with iOS and macOS version families kept distinct. An “other” tag includes a test marker outside the numeric version shapes.</p><ul>{summary.projects.map(project=><li><strong>{project.label}</strong><span>{project.tagCount} {project.tagCount===1?'tag':'tags'} · earliest source commit {project.firstCommit?.date ?? 'unavailable'} · {project.firstTag ? `first tag ${project.firstTag}`:'no tags in inspected snapshot'}</span></li>)}</ul><p>Snapshot date: {summary.asOf}. All 21 inspected repositories returned metadata after their origin tag references were refreshed.</p></div></details>
</section>
<script>import { mountReleaseExplorer } from '../releases/controller';mountReleaseExplorer();</script>
