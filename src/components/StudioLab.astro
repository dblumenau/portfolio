---
import Icon from './Icon.astro';
import { backgrounds, rolePresets } from '../labs/studio/model';
---
<section class="studio-workshop" data-studio aria-labelledby="studio-title">
  <div class="studio-topline"><div><span class="studio-dot" aria-hidden="true"></span><strong id="studio-title">Your print bench</strong></div><span>01 / A small thing worth making</span></div>
  <div class="studio-bench">
    <div class="studio-stage-column">
      <div class="studio-stage"><div class="studio-registration" aria-hidden="true"><span><Icon name="plus" /></span><span><Icon name="plus" /></span><span><Icon name="plus" /></span><span><Icon name="plus" /></span></div><canvas class="studio-canvas" data-canvas width="1080" height="1080" aria-label="Live preview of your social tile"></canvas><noscript><p>Turn on JavaScript to make and download a tile in this browser.</p></noscript></div>
      <div class="studio-playhead"><button type="button" data-action="play" aria-pressed="true" aria-label="Pause animation"><Icon name="pause" /></button><label>Find a frame<input type="range" data-control="time" aria-label="Animation frame" min="0" max="3999" value="0" step="1" /></label><output data-time>0.00 s</output></div>
      <div class="studio-output"><div><span class="eyebrow">Take something away</span><p>1080 × 1080 px · your current frame</p></div><div class="studio-downloads"><button class="studio-primary" type="button" data-action="png">Download PNG <span aria-hidden="true"><Icon name="arrow-up-right" /></span></button><button type="button" data-action="jpg">JPG</button><button type="button" data-action="mp4" disabled>4s MP4</button></div><p class="studio-capability" data-capability>Checking local video support…</p><progress data-progress max="100" value="0" hidden aria-label="Export progress"></progress><button type="button" data-action="cancel" hidden>Cancel clip</button></div>
      <p class="studio-status" data-status role="status" aria-live="polite">Preparing the first print…</p>
    </div>
    <form class="studio-controls" data-controls id="studio-controls">
      <fieldset><legend><span>01</span> Set the words</legend><label>Start from a role<select data-control="role">{rolePresets.map(p => <option value={p.id} selected={p.id==='custom'}>{p.label}</option>)}</select></label><div class="studio-word-pair"><label>Small line<input data-control="prefix" maxlength="40" value="LET’S MAKE" autocomplete="off" /></label><label>Headline<input data-control="headline" maxlength="90" value="Something useful" autocomplete="off" /></label></div><label>Occasion<input data-control="event" maxlength="120" value="A small idea, made real." autocomplete="off" /></label><label>Name or studio<input data-control="name" maxlength="100" value="The Sunday Studio" autocomplete="off" /></label><label>One more line <span class="studio-optional">optional</span><input data-control="detail" maxlength="140" value="Creative experiments · Copenhagen" autocomplete="off" /></label></fieldset>
      <fieldset><legend><span>02</span> Give it a mood</legend><div class="studio-backgrounds" role="group" aria-label="Background">{backgrounds.map((b,i) => <button type="button" data-background={b.id} aria-pressed={b.id==='forest-mist'} style={`--swatch:${b.colorTint};--swatch-back:${b.colorBack}`}><span class="studio-swatch" aria-hidden="true"></span><span>{['Amber','Teal','Forest'][i]}</span></button>)}</div><div class="studio-settings-row"><label>Type<select data-control="font"><option value="sans">Clean / Sans</option><option value="serif">Warm / Serif</option><option value="mono">Precise / Mono</option></select></label><label>Ink<input type="color" data-control="ink" value="#ffffff" /></label></div><label>Headline presence <output data-scale>100%</output><input type="range" data-control="scale" aria-label="Headline presence" min="75" max="115" step="1" value="100" /></label></fieldset>
      <fieldset><legend><span>03</span> Arrange the print</legend><div class="studio-compositions" role="group" aria-label="Composition"><button type="button" data-composition="poster" aria-pressed="true"><span class="studio-layout-icon studio-layout-poster" aria-hidden="true">Aa</span>Poster</button><button type="button" data-composition="center" aria-pressed="false"><span class="studio-layout-icon studio-layout-center" aria-hidden="true">Aa</span>Centred</button><button type="button" data-composition="corner" aria-pressed="false"><span class="studio-layout-icon studio-layout-corner" aria-hidden="true">Aa</span>Up top</button></div></fieldset>
      <div class="studio-controls-foot"><p>Words and colours stay in this tab. Close it and they’re gone.</p><button type="button" data-action="reset">Start again <Icon name="rotate" /></button></div>
    </form>
  </div>
  <div class="studio-mobile-proof" data-mini hidden><canvas width="216" height="216" data-mini-canvas aria-hidden="true"></canvas><div><strong>Your print, as you edit</strong><span>Same composition. Live ink.</span></div><button type="button" data-action="return">Check &amp; download <Icon name="arrow-up" /></button></div>
</section>
<script>
 import { initializeStudio } from '../labs/studio/controller';
 document.querySelectorAll<HTMLElement>('[data-studio]').forEach(initializeStudio);
</script>
