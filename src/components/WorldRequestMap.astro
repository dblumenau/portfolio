---
import Icon from './Icon.astro';
import { caseDefinitions, projectCase, fields, boundary, artifactBoundary, aliasNote, source } from '../world/request-map/model';
interface Props { fallback?: boolean }
const { fallback = false } = Astro.props;
const records = caseDefinitions.map(item => projectCase(item.key));
---
{fallback ? <details class="world-request-readable" id="request-map-readable"><summary>Map one recorded request</summary><p>{boundary}</p><p>{artifactBoundary} Local SVG diagram export requires JavaScript.</p><h2>Four recorded cases</h2>{records.map(record => <details class="request-readable-case"><summary>{record.question}</summary><h3>{record.caller} / {record.tool}</h3><p><strong>{record.outcome}</strong></p><p>{record.status} · {record.upstreamToolCalls} observed backend tool {record.upstreamToolCalls === 1 ? 'call' : 'calls'}</p>{fields.map(field => <section><h4>{field.label}</h4>{record.evidence[field.key].map(fact => <p>{fact}</p>)}</section>)}<p>Case: {record.key}. Recorded {source.date}, gateway {source.tag}.</p></details>)}<p><a href="/labs/gateway/">Open the full Gateway Lab</a> <a href="/media/gateway/receipt.json">Read the original receipt</a> <a href="/media/gateway/transcript.txt">Read the recorded transcript</a></p></details> : <>
  <div class="world-request-overlay" data-request-overlay hidden aria-hidden="true"><span>THE CONNECTIONS DESK</span><div class="request-scene-windows"><span data-request-window="caller">Caller</span><span data-request-window="resource">Resource access</span><span data-request-window="policy">Tool list / policy</span></div><p data-request-scene-note>A recorded request, ready to open.</p></div>
  <aside class="world-request-card" data-request-card aria-label="Map a recorded gateway request" hidden>
    <div class="request-top"><span>MAKE THE BOUNDARY VISIBLE</span><button type="button" class="world-text-button" data-request-exit><Icon name="arrow-left" /> Return to the world</button></div>
    <h2 tabindex="-1">One request.<br /><em>What happened?</em></h2>
    <p class="request-boundary">{boundary}<span class="request-code-note">Real gateway code {source.tag}, recorded {source.date}.</span></p>
    <section class="request-case" aria-label="Selected recorded case"><p class="request-kicker">ONE EXACT RECORDED CASE</p><h3 data-request-question tabindex="-1">{records[0]!.question}</h3><p class="request-role" data-request-role>{records[0]!.caller} / {records[0]!.tool}</p><button type="button" class="world-button world-button-solid" data-request-open disabled>Open this recorded case <Icon name="arrow-right" /></button><div class="request-outcome" data-request-outcome hidden><strong data-request-result></strong><span data-request-status></span><p><b data-request-count></b><span>observed backend tool calls</span></p></div></section>
    <details class="request-choose"><summary>Compare another recorded case</summary><div>{records.map(record => <button type="button" data-request-case={record.key} disabled><strong>{record.question}</strong><span>{record.caller} / {record.tool}</span><Icon name="arrow-right" /></button>)}</div></details>
    <p data-request-notice class="request-notice" role="status">Opening the local diagram desk.</p>
    <div data-request-inspection hidden>
      <div class="request-fields" aria-label="Inspect recorded evidence">{fields.map(field => <button type="button" data-request-field={field.key} aria-pressed="false">{field.label}</button>)}</div>
      <section class="request-evidence" data-request-evidence aria-label="Selected evidence"><p class="request-kicker">READ THE SUPPORTING EVIDENCE</p><h3 data-request-evidence-title></h3><div data-request-facts></div></section>
      <section class="request-artifact" aria-label="Your SVG evidence map"><p class="request-kicker">A SMALL MAP TO KEEP</p><p>Carry this recorded boundary away as a readable SVG, with the case and source attached.</p><button type="button" class="world-button world-button-solid" data-request-build>Build my evidence map <Icon name="arrow-right" /></button><div data-request-saved hidden><details class="request-preview"><summary>See the map I can save</summary><img data-request-preview width="1080" height="1320" alt="Your locally assembled evidence map" decoding="async" /></details><a class="world-button" data-request-download download="gateway-evidence-map.svg">Download SVG map <Icon name="arrow-down" /></a></div><p data-request-export-status role="status"></p></section>
    </div>
    <details class="request-method"><summary>What was recorded?</summary><p>Real gateway code {source.tag}, recorded {source.date}, ran with fictional local auth, permission and music services. The windows arrange separate evidence questions; they are an illustration, not a timestamped middleware trace.</p><p>This map covers four proxy calls. Production access policy, live authorization, OAuth validation, real credentials/provider actions and native-profile fallback behavior are outside its scope.</p><p>{aliasNote}</p><p>Selected record: <code data-request-key>{records[0]!.key}</code>. Catalog: <span data-request-catalog-ref></span>.</p><a href="/media/gateway/receipt.json">Read the original receipt <Icon name="arrow-up-right" /></a><a href="/media/gateway/transcript.txt">Read the recorded transcript <Icon name="arrow-up-right" /></a></details>
    <a class="request-lab-link" href="/labs/gateway/">Read the fuller Gateway Lab <Icon name="arrow-up-right" /></a>
  </aside>
</>}
