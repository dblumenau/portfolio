---
import Icon from './Icon.astro';
interface Props { kind: string; slug: string; }
const { kind } = Astro.props;
---
{kind === 'timeline' && <div class="feature-specimen specimen-timeline">
  <ol aria-label="Illustrative agent activity">
    <li><span>01</span><div><small>Request</small><p>Find a material for the Lantern prototype.</p></div></li>
    <li><span>02</span><div><small>Tool / read-only lookup</small><p>Catalog search is running.</p><details><summary>Inspect the synthetic tool record</summary><code>lookup_materials({'{'} purpose: "offline prototype" {'}'})</code><p>Result: three fictional entries.</p></details></div></li>
    <li><span>03</span><div><small>Final answer</small><p>Two entries suit a small offline prototype.</p></div></li>
  </ol>
</div>}
{kind === 'recovery' && <div class="feature-specimen specimen-recovery"><div><p class="exhibit-object-label">Foreground / client lane</p><ol><li>Request starts</li><li class="specimen-disconnect">Connection disappears</li><li>Reconnect <Icon name="arrow-right" /> retrieve result</li></ol></div><div><p class="exhibit-object-label">Background / engine lane</p><ol><li>Turn starts</li><li>Tool completes</li><li>Completion stored</li></ol></div><p class="specimen-footnote">Illustrated browser/SSE disconnect. The engine stays running; permission behavior depends on its configured disconnect policy.</p></div>}
{kind === 'adapters' && <div class="feature-specimen specimen-adapters"><div class="adapter-inputs"><div><strong>Claude</strong><span>Agent SDK / CLI</span></div><div><strong>Codex</strong><span>app-server / JSON-RPC</span></div><div><strong>OpenCode</strong><span>serve / event stream</span></div></div><div class="adapter-output"><span>Client-facing event contract</span><p>Text <i><Icon name="arrow-right" /></i> Tool activity <i><Icon name="arrow-right" /></i> Final answer</p></div><p class="specimen-footnote">A shared display contract. Each engine retains its own runtime, session and capabilities.</p></div>}
{kind === 'gates' && <div class="feature-specimen specimen-gates"><p class="exhibit-object-label">Fictional request / read_notes</p><ol><li><span>01 / Identity</span><strong>Signed-in identity</strong><p>Who is making this request?</p></li><li><span>02 / Resource scope</span><strong>notes:read</strong><p>May they use this resource?</p></li><li><span>03 / Tool profile</span><strong>read_notes selected</strong><p>Is this tool exposed by the profile?</p></li></ol><p class="specimen-footnote">The permitted request continues to forwarding. One successful check does not stand in for the others.</p></div>}
{kind === 'question' && <div class="feature-specimen specimen-question"><div class="question-agent"><p class="exhibit-object-label">Waiting task</p><h3>Continue the poster.</h3><p>One human choice is missing.</p><span>Pending decision · example-01</span></div><div class="question-card"><p class="exhibit-object-label">Illustrative Engine question card</p><h3>Which direction should I keep?</h3><details><summary>Choose warm terracotta</summary><p>Answer: warm terracotta.<br />The waiting task can continue with this decision.</p></details><details><summary>Decline this decision</summary><p>Decision declined.<br />The task receives a decline rather than an invented preference.</p></details></div></div>}
{kind === 'voice' && <div class="feature-specimen specimen-voice"><ol aria-label="Illustrative voice phases"><li><span>01</span>Listen</li><li><span>02</span>Transcribe</li><li><span>03</span>Respond</li><li><span>04</span>Speak</li></ol><div class="voice-specimen-record"><div class="voice-bars" aria-hidden="true">{[12,30,19,42,28,52,22,38,15,30,20].map((height) => <i style={`--bar-height:${height}px`}></i>)}</div><p><small>Fictional transcript</small>“Find the last decision about the poster.”</p></div><p class="specimen-footnote">Visible phases explain the audio loop. This example uses no microphone, speech service or generated audio.</p></div>}
{kind === 'library' && <div class="feature-specimen specimen-library"><div><p class="exhibit-object-label">Before / Studio workspace</p><ol><li>Studio<ol><li>Lantern project<ol><li>Evening scene<ol><li>Poster panel</li></ol></li></ol></li></ol></li></ol></div><div><p class="exhibit-object-label">After / Archive workspace</p><ol><li>Archive<ol><li>Lantern project<ol><li>Evening scene<ol><li>Poster panel</li></ol></li></ol></li></ol></li></ol></div><p class="specimen-footnote">Move the project between workspaces; preserve the scene and panel it contains.</p></div>}
