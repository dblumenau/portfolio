---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import VideoDemo from './VideoDemo.astro';
const image = '/media/apple-client.webp';
const available = existsSync(resolve('public', image.slice(1)));
const caption = 'Native iPhone app · iPhone Simulator · saved conversation · edited recording';
---
{available && <section class="native-client-demo" aria-labelledby="native-client-title">
  <figure class="native-screen"><a href={image} aria-label="Open full-resolution screenshot of the native iPhone client"><img src={image} width="1206" height="2622" loading="lazy" decoding="async" alt="The native Apple client on an iPhone Simulator, showing a saved showcase conversation." /></a><figcaption class="media-caption">Native iPhone app in the simulator, displaying a saved showcase conversation.</figcaption></figure>
  <div class="native-copy"><p class="eyebrow">Another screen for the same work</p><h3>A native client on the device at hand.</h3><p>The Apple app gives conversations their own interface on iPhone and iPad. The web workspace above shows a separate responsive client; this capture shows the native application.</p><VideoDemo src="/media/apple-client-workflow.mp4" poster={image} captions="/media/apple-client-workflow.vtt" title="Open the work on iPhone" description="A saved showcase conversation opens in the native client. Chat options reveal the provider and model controls; the menus open, then the recording returns to the chat without changing the selection. The local workspace path is hidden. Cuts remove waiting time." mediaCaption={caption} /></div>
</section>}
