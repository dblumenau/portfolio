---
import Icon from './Icon.astro';
---
<div class="overview" data-overview>
  <div class="overview-actions">
    <slot />
    <a class="overview-trigger" href="/media/overview/selected-work-overview.mp4" data-overview-trigger><Icon name="play" /><span>Watch the tour</span></a>
    <noscript><a class="overview-text-fallback" href="/media/overview/selected-work-text-alternative.txt">Read the tour</a></noscript>
  </div>
  <dialog class="overview-dialog" id="overview-film" aria-labelledby="overview-title" data-overview-dialog>
    <header class="overview-heading">
      <div><p>78 seconds · Silent · English captions</p><h2 id="overview-title">A small tour of the work.</h2></div>
      <button type="button" class="overview-close" data-overview-close autofocus>Close <Icon name="close" /></button>
    </header>
    <div class="overview-content">
      <figure>
        <video controls playsinline preload="none" width="1920" height="1080" tabindex="0" aria-label="Selected work by David Blumenau" aria-describedby="overview-caption" data-overview-video data-src="/media/overview/selected-work-overview.mp4" data-poster="/media/overview/selected-work-poster.jpg">
          <track kind="captions" srclang="en" label="English" default data-src="/media/overview/selected-work-overview.vtt" />
          <a href="/media/overview/selected-work-overview.mp4">Download the tour.</a>
        </video>
        <figcaption id="overview-caption">Actual product captures, a recorded recovery experiment and working browser tools. World is an interactive illustration; the native answer was chosen by automated Computer Use.</figcaption>
      </figure>
      <nav class="overview-links" aria-label="Tour alternatives"><a href="/media/overview/selected-work-text-alternative.txt">Read the text alternative <Icon name="arrow-up-right" /></a><a href="/media/overview/selected-work-overview.mp4" download>Download the film <Icon name="arrow-down" /></a></nav>
      <details class="overview-details"><summary>About these scenes</summary><p>The teapot images show completed generations. Attention shows the actual Mac exchange on build 121; the separate later build 128 observation is outside this edit. Recovery uses one continuing local engine process. World uses the recorded answer and starts no new task.</p></details>
    </div>
  </dialog>
</div>
<script>
  import { initializeOverviewFilm } from '../showcases/overview/controller';
  document.querySelectorAll<HTMLElement>('[data-overview]').forEach(initializeOverviewFilm);
</script>
<style>
  .overview-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
  .overview-trigger{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:48px;padding:8px 0;font-size:15px;font-weight:600;text-decoration:none;white-space:nowrap}
  .overview-trigger:hover span{text-decoration:underline;text-underline-offset:5px}
  .overview-trigger :global(.ui-icon){width:17px;height:17px;color:var(--rust)}
  .overview-text-fallback{display:inline-flex;align-items:center;min-height:44px;font-size:14px}
  .overview-dialog{width:min(1120px,calc(100% - 32px));max-height:calc(100dvh - 32px);margin:auto;padding:0;overflow-y:auto;border:1px solid #819477;border-radius:6px;background:var(--paper);color:var(--ink);box-shadow:0 24px 90px #0005}
  .overview-dialog::backdrop{background:#16271fe0}
  .overview-heading{position:sticky;top:0;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 24px;background:var(--paper);border-bottom:1px solid var(--line)}
  .overview-heading p{font-size:13px;color:var(--muted);margin-bottom:5px}
  .overview-heading h2{font-size:27px;letter-spacing:-.035em;line-height:1.15}
  .overview-close{display:inline-flex;align-items:center;justify-content:center;gap:12px;flex-shrink:0;min-height:44px;padding:8px 12px;border:1px solid #819477;border-radius:3px;background:var(--paper);font-size:14px;cursor:pointer}
  .overview-close:hover{background:#e5e8d9}
  .overview-close :global(.ui-icon){width:16px;height:16px}
  .overview-content{padding:20px 24px 24px}
  .overview-content video{width:100%;height:auto;max-height:calc(100dvh - 145px);background:#192c23;object-fit:contain;aspect-ratio:16/9}
  .overview-content figcaption{font-size:14px;line-height:1.65;margin-top:16px;color:var(--muted)}
  .overview-links{display:flex;align-items:center;gap:12px 28px;flex-wrap:wrap;margin-top:8px}
  .overview-links a{display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:14px}
  .overview-links :global(.ui-icon){width:15px;height:15px}
  .overview-details{border-top:1px solid var(--line);margin-top:10px;font-size:14px}
  .overview-details summary{min-height:44px;padding-block:12px;font-weight:600}
  .overview-details p{max-width:850px;line-height:1.7;color:var(--muted);margin:0 0 6px}
  @media(max-width:600px){
    .overview-content video:not(:fullscreen)::cue{font-size:14px}
    .overview-actions{gap:14px}
    .overview-actions :global(.button){gap:12px}
    .overview-trigger{font-size:14px;gap:7px}
    .overview-dialog{width:calc(100% - 20px);max-height:calc(100dvh - 20px)}
    .overview-heading{padding:14px;gap:12px}
    .overview-heading h2{font-size:21px}
    .overview-heading p{font-size:12px;max-width:210px}
    .overview-close{gap:8px;padding-inline:10px}
    .overview-content{padding:14px}
    .overview-links{gap:0 18px}
  }
</style>
